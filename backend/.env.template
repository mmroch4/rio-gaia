STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# REQUIRED — generate secure random values, e.g.: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=postgres://postgres@localhost/$DB_NAME
DB_NAME=medusa-backend

# MeiliSearch Configuration
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=your-master-key
MEILISEARCH_PRODUCT_INDEX_NAME=products
MEILI_MASTER_KEY=your-master-key

# Worker mode (shared for dev, server/worker for production)
MEDUSA_WORKER_MODE=shared

# Backend & Storefront URLs
BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# Disable admin dashboard (true for worker mode in production)
DISABLE_MEDUSA_ADMIN=false

# Enable Medusa Cache
MEDUSA_FF_CACHING=true

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS S3 File Storage (leave S3_BUCKET blank to fall back to local filesystem for dev)
# file_url is the public asset base (https://<bucket>.s3.<region>.amazonaws.com)
# endpoint is the S3 API URL (https://s3.<region>.amazonaws.com) — not the same thing
# For MinIO/Supabase/Cloudflare R2, consult the Medusa S3 docs for forcePathStyle and endpoint specifics
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PREFIX=