# ══════════════════════════════════════════
# Rio Gaia Production Environment Variables
# Set these in Coolify UI → Project → Environment
# Generate secrets: openssl rand -hex 32
# ══════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=riogaia
POSTGRES_USER=riogaia
POSTGRES_PASSWORD=          # openssl rand -hex 32

# ── Redis ──
REDIS_PASSWORD=             # openssl rand -hex 32

# ── Meilisearch ──
MEILI_MASTER_KEY=           # openssl rand -hex 32 (min 16 bytes)
# After first deploy, create a search-only key:
#   curl -X POST 'https://search.riogaia.com/keys' \
#     -H 'Authorization: Bearer <MEILI_MASTER_KEY>' \
#     -H 'Content-Type: application/json' \
#     --data '{"actions":["search"],"indexes":["products"],"expiresAt":null}'
MEILISEARCH_PRODUCT_INDEX_NAME=products

# ── Medusa Secrets ──
JWT_SECRET=                 # openssl rand -hex 32
COOKIE_SECRET=              # openssl rand -hex 32

# ── Medusa CORS (comma-separated origins) ──
STORE_CORS=https://riogaia.com,https://www.riogaia.com
ADMIN_CORS=https://api.riogaia.com
AUTH_CORS=https://riogaia.com,https://www.riogaia.com,https://api.riogaia.com

# ── URLs ──
BACKEND_URL=https://api.riogaia.com
STOREFRONT_URL=https://riogaia.com

# ── Storefront (build-time, set as Build Variables in Coolify) ──
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=  # from Medusa admin → Settings → API Keys
NEXT_PUBLIC_MEILISEARCH_HOST=https://search.riogaia.com
NEXT_PUBLIC_MEILISEARCH_API_KEY=     # search-only key from step above
NEXT_PUBLIC_DEFAULT_REGION=pt

# ── SMTP Email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rio Gaia <noreply@riogaia.com>
